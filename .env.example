# ---- core ----
JOBOS_DATABASE_URL=postgresql+psycopg://jobos:jobos@localhost:5432/jobos
JOBOS_DATA_DIR=./data
JOBOS_API_TOKEN=change-me-long-random-string
JOBOS_SECRET_KEY=change-me-32-plus-random-characters-here
JOBOS_PUBLIC_BASE_URL=http://localhost:8000      # public https URL (Cloudflare Tunnel) for WhatsApp webhooks
JOBOS_WEB_BASE_URL=http://localhost:3000

# ---- LLM (ADR-0011) ----
JOBOS_OPENROUTER_API_KEY=sk-or-...
# per-task routes; prefix keys apply to all tasks under them
# JOBOS_LLM_ROUTES={"form":"openrouter:anthropic/claude-sonnet-5.5","job":"openrouter:anthropic/claude-haiku-5.5"}
JOBOS_LLM_DAILY_BUDGET_USD=5

# ---- workers ----
JOBOS_WORKER_ROLE=all            # api | worker | all
JOBOS_APPLY_CONCURRENCY=200       # queue slots; real throttles: 1 per employer, pacing, runner tabs

# ---- notifications (ADR-0012) ----
JOBOS_RESEND_API_KEY=
JOBOS_EMAIL_FROM=JobOS <jobs@your-domain.com>
JOBOS_NOTIFY_EMAIL_TO=you@your-domain.com
JOBOS_WHATSAPP_TOKEN=
JOBOS_WHATSAPP_PHONE_NUMBER_ID=
JOBOS_WHATSAPP_TO=91XXXXXXXXXX
JOBOS_WHATSAPP_VERIFY_TOKEN=pick-a-random-string
JOBOS_WHATSAPP_APP_SECRET=
JOBOS_WHATSAPP_TEMPLATE=

# ---- web dashboard ----
JOBOS_API_URL=http://localhost:8000
JOBOS_WEB_PASSWORD=change-me
